// Powerhouse — Entity Relationship Model
// Version: 3.3.46 | Date: 2026-03-11

// ============================================================
// Enums
// ============================================================

Enum limit_type {
  unlimited   [note: '無期限']
  fixed       [note: '購買後固定時間']
  assigned    [note: '指定日期（timestamp）']
  follow_subscription [note: '跟隨訂閱到期']
}

Enum limit_unit {
  timestamp [note: '時間戳記']
  day       [note: '天']
  month     [note: '月']
  year      [note: '年']
}

Enum lc_post_status {
  activated [note: '已啟用']
  available [note: '可用']
  empty     [note: '未設定（空字串）']
}

Enum subscription_status {
  active          [note: '已啟用']
  on_hold         [note: '保留（嘗試付款中）']
  pending_cancel  [note: '待取消']
  cancelled       [note: '已取消']
  expired         [note: '已過期']
}

Enum subscription_action {
  date_created              [note: '訂閱創建後']
  initial_payment_complete  [note: '首次付款成功']
  subscription_failed       [note: '訂閱失敗']
  subscription_success      [note: '訂閱恢復成功']
  payment_retry             [note: '付款重試']
  trial_end                 [note: '試用結束']
  next_payment              [note: '下次付款']
  renewal_order_created     [note: '續訂訂單建立']
  end                       [note: '訂閱結束']
  end_of_prepaid_term       [note: '預付期結束']
}

// ============================================================
// Custom Table（外掛啟用時建立）
// ============================================================

Table ph_access_itemmeta {
  meta_id    bigint [pk, increment, note: '主鍵']
  post_id    bigint [not null, note: '內容項目 ID（文章/課程等）']
  user_id    bigint [not null, note: 'WordPress 用戶 ID']
  meta_key   varchar(255) [default: null, note: 'Meta 鍵，如 expire_date']
  meta_value longtext [note: 'Meta 值，如到期 timestamp 或 subscription_{id}']

  indexes {
    post_id [name: 'post_id']
    user_id [name: 'user_id']
    meta_key [name: 'meta_key']
  }

  Note: '''
  儲存每位用戶對每個內容項目的存取權限 meta 資料。
  主要用於 Limit 模組的觀看權限管理。
  表名前綴為 WordPress 的 $wpdb->prefix。
  '''
}

// ============================================================
// WordPress Options（wp_options 表）
// ============================================================

Table wp_options__powerhouse_settings {
  option_name  varchar(191) [pk, note: "固定值: 'powerhouse_settings'"]
  option_value longtext [note: '序列化的設定陣列']

  Note: '''
  Powerhouse 外掛的所有設定值，以序列化陣列存放。
  包含：驗證碼設定、WooCommerce 設定、主題設定、
  API 加速器規則、BunnyCDN 設定等。
  '''
}

Table wp_options__powerhouse_license_codes {
  option_name  varchar(191) [pk, note: "固定值: 'powerhouse_license_codes'"]
  option_value longtext [note: '序列化的陣列 { product_slug => code }']

  Note: '''
  儲存各產品 slug 對應的授權碼。
  格式：array<string, string>（product_slug => code）
  '''
}

Table wp_options__powerhouse_compatibility {
  option_name  varchar(191) [pk, note: "固定值: 'powerhouse_compatibility_action_scheduled'"]
  option_value longtext [note: '上次執行相容性檢查的版本號']

  Note: '''
  紀錄最後一次執行版本相容性排程的外掛版本。
  '''
}

// ============================================================
// WordPress Transients（wp_options 表中的臨時快取）
// ============================================================

Table wp_transient__lc {
  transient_name varchar(191) [pk, note: "格式: 'lc_{product_slug}'"]
  transient_value longtext [note: 'AES 加密的授權狀態 JSON']
  transient_expiration bigint [note: '過期時間（24 小時）']

  Note: '''
  各產品的授權碼狀態快取，使用 AES 加密存放。
  解密後格式：{ code, post_status, expire_date, type, product_slug, product_name }
  過期時間：24 小時（CACHE_TIME = 24 * HOUR_IN_SECONDS）
  '''
}

// ============================================================
// WordPress 核心表參照（不由本外掛建立，但會使用）
// ============================================================

Table wp_posts {
  ID          bigint [pk, note: '文章/商品/訂單等 ID']
  post_type   varchar(20) [note: '文章類型']
  post_status varchar(20) [note: '文章狀態']
  post_title  text [note: '標題']
  post_parent bigint [note: '父文章 ID']
  menu_order  int [note: '排序']

  Note: '''
  WordPress 核心文章表，Powerhouse 透過通用 CRUD API 操作。
  支援所有 post_type：post, page, product, shop_order, attachment 等。
  '''
}

Table wp_postmeta {
  meta_id    bigint [pk]
  post_id    bigint [not null]
  meta_key   varchar(255)
  meta_value longtext

  Note: '''
  WordPress 文章 meta 表。
  Powerhouse 使用的 meta_key 包括：
  - bound_items_data: 商品綁定的存取權限項目（JSON 陣列）
  - bound_items_data_ids: 綁定項目的 ID（多筆，方便檢索）
  - limit_type / limit_value / limit_unit: Limit 模型的觀看限制設定
  '''
}

Table wp_users {
  ID            bigint [pk, note: '用戶 ID']
  user_login    varchar(60) [note: '登入名稱']
  user_email    varchar(100) [note: '電子郵件']
  display_name  varchar(250) [note: '顯示名稱']

  Note: 'WordPress 核心用戶表'
}

Table wp_usermeta {
  umeta_id   bigint [pk]
  user_id    bigint [not null]
  meta_key   varchar(255)
  meta_value longtext

  Note: 'WordPress 用戶 meta 表'
}

Table wp_terms {
  term_id bigint [pk, note: '詞彙 ID']
  name    varchar(200) [note: '名稱']
  slug    varchar(200) [note: 'Slug']

  Note: 'WordPress 核心詞彙表'
}

Table wp_term_taxonomy {
  term_taxonomy_id bigint [pk]
  term_id          bigint [not null]
  taxonomy         varchar(32) [note: '分類法名稱']
  parent           bigint [default: 0]
  count            bigint [default: 0]

  Note: 'WordPress 詞彙分類法關聯表'
}

Table wp_termmeta {
  meta_id    bigint [pk]
  term_id    bigint [not null]
  meta_key   varchar(255)
  meta_value longtext

  Note: '''
  WordPress 詞彙 meta 表。
  Powerhouse 使用的 meta_key：
  - order: 詞彙排序值
  - thumbnail_id: 詞彙縮圖 attachment ID
  '''
}

Table wp_comments {
  comment_ID      bigint [pk, note: '評論 ID']
  comment_content text [note: '評論內容']
  comment_type    varchar(20) [note: '評論類型']
  user_id         bigint [note: '評論者用戶 ID']

  Note: 'WordPress 核心評論表'
}

// ============================================================
// WooCommerce 表參照
// ============================================================

Table wp_wc_order_stats {
  order_id   bigint [pk, note: '訂單 ID']
  parent_id  bigint [note: '父訂單 ID']
  status     varchar(20) [note: '訂單狀態']
  net_total  double [note: '淨收入']
  total_sales double [note: '總銷售額']

  Note: '''
  WooCommerce 訂單統計表。
  Powerhouse Revenue API 使用此表計算營收報表，
  並擴展了 refunded_orders_count 和 non_refunded_orders_count 欄位。
  '''
}

// ============================================================
// References
// ============================================================

Ref: ph_access_itemmeta.post_id > wp_posts.ID
Ref: ph_access_itemmeta.user_id > wp_users.ID
Ref: wp_postmeta.post_id > wp_posts.ID
Ref: wp_usermeta.user_id > wp_users.ID
Ref: wp_term_taxonomy.term_id > wp_terms.term_id
Ref: wp_termmeta.term_id > wp_terms.term_id
Ref: wp_comments.user_id > wp_users.ID
